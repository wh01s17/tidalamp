/* Semantic palette: Omarchy when available, classic Winamp elsewhere. */

Screen {
    background: $tidalamp-screen;
}

#main {
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    height: 100%;
}

#titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: center;
    text-style: bold;
    height: 1;
}

#display {
    background: $tidalamp-display-background;
    height: 9;
    padding: 0 1;
}

#clock {
    width: 24;
    height: 4;
    padding: 1 0 0 1;
}

#readout {
    width: 1fr;
    padding: 1 1 0 1;
}

#badges {
    color: $tidalamp-muted;
    height: 1;
}

#seek {
    background: $tidalamp-track-background;
    padding: 0 1;
    height: 1;
}

#volume {
    background: $tidalamp-track-background;
    padding: 0 1;
    width: 44;
    height: 1;
}

#balance {
    background: $tidalamp-track-background;
    padding: 0 1;
    width: 44;
    height: 1;
}

#transport {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

#modes {
    background: $tidalamp-track-background;
    color: $tidalamp-inactive;
    height: 1;
}

#pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
}

#playlist {
    background: $tidalamp-display-background;
    padding: 0 1;
}

#status {
    background: $tidalamp-track-background;
    color: $tidalamp-status;
    height: 1;
}

SearchScreen {
    align: center middle;
}

#search-box {
    width: 60;
    height: auto;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    padding: 1 2;
}

#search-title {
    color: $tidalamp-accent;
    text-style: bold;
    height: 1;
}

#search-input {
    background: $tidalamp-display-background;
    color: $tidalamp-accent;
    border: tall $tidalamp-input-border;
}

BrowserScreen {
    align: center middle;
}

#browser-box {
    width: 84;
    height: 26;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#browser-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#browser-list {
    background: $tidalamp-display-background;
    height: 1fr;
    padding: 0 1;
}

#browser-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

LyricsScreen {
    align: center middle;
}

#lyrics-box {
    width: 84;
    height: 28;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#lyrics-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#lyrics-body {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: 1fr;
    padding: 1 2;
}

#lyrics-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

EqScreen {
    align: center middle;
}

#eq-box {
    width: 60;
    height: 17;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#eq-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#eq-bars {
    background: $tidalamp-display-background;
    height: 1fr;
    padding: 1 2;
}

#eq-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}
