/* Semantic palette: Omarchy when available, classic Winamp elsewhere. */

Screen {
    background: $tidalamp-screen;
    layers: base notice;
}

/* Sits above everything so a broken layout is never what the user sees. */
#too-small {
    layer: notice;
    display: none;
    width: 100%;
    height: 100%;
    background: $tidalamp-screen;
    color: $tidalamp-accent;
}

#main {
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    height: 100%;
}

#titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: center;
    text-style: bold;
    height: 1;
}

#display {
    background: $tidalamp-display-background;
    height: 9;
    padding: 0 1;
}

#clock {
    width: 24;
    height: 4;
    padding: 1 0 0 1;
}

#readout {
    width: 1fr;
    padding: 1 1 0 1;
}

#badges {
    color: $tidalamp-muted;
    height: 1;
}

/* The display band grows with the terminal to make room for a bigger cover.
   Analyzer.render already draws to whatever height it is given, so letting it
   take the slack keeps the bars beside the cover instead of leaving a hole. */
#analyzer {
    height: 1fr;
}

#seek {
    background: $tidalamp-track-background;
    padding: 0 1;
    height: 1;
}

#volume {
    background: $tidalamp-track-background;
    padding: 0 1;
    width: 44;
    height: 1;
}

#balance {
    background: $tidalamp-track-background;
    padding: 0 1;
    width: 44;
    height: 1;
}

#transport {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 3;
}

/* The transport keys keep their place under the sliders; everything else is
   a menu and sits against the right edge, so the two do not read as one run
   of characters. */
#transport-play {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    width: auto;
    height: 3;
}

#transport-menu {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    width: 1fr;
    height: 3;
    text-align: right;
    /* One line, cropped when it does not fit. Wrapped, it climbed into the
       buttons' rows and the whole band turned to soup. */
    text-wrap: nowrap;
}

#pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
}

#playlist {
    background: $tidalamp-display-background;
    padding: 0 1;
    /* 1fr, not auto: RowList paints as many rows as it is given, so an auto
       height grows until the status bar falls off the bottom of the screen. */
    height: 1fr;
}

#status {
    background: $tidalamp-track-background;
    color: $tidalamp-status;
    height: 1;
    width: 1fr;
}

SearchScreen {
    align: center middle;
}

#search-box {
    width: 60;
    height: auto;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    padding: 1 2;
}

#search-title {
    color: $tidalamp-accent;
    text-style: bold;
    height: 1;
}

#search-input {
    background: $tidalamp-display-background;
    color: $tidalamp-accent;
    border: tall $tidalamp-input-border;
}

BrowserScreen {
    align: center middle;
}

#browser-box {
    width: 84;
    height: 26;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#statusbar {
    height: 1;
    background: $tidalamp-track-background;
}

#busy {
    background: $tidalamp-track-background;
    width: auto;
    padding: 0 1;
}

#lyrics-head {
    background: $tidalamp-title-background;
    height: 1;
}

#browser-head {
    background: $tidalamp-title-background;
    height: 1;
}

#browser-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    width: 1fr;
    padding: 0 1;
}

#browser-spinner {
    background: $tidalamp-title-background;
    width: 34;
    padding: 0 1;
}

#browser-list {
    background: $tidalamp-display-background;
    height: 1fr;
    padding: 0 1;
}

#browser-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

LyricsScreen {
    align: center middle;
}

#lyrics-box {
    width: 84;
    height: 28;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#lyrics-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    width: 1fr;
    padding: 0 1;
}

#lyrics-spinner {
    background: $tidalamp-title-background;
    width: 34;
    padding: 0 1;
}

#lyrics-body {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: 1fr;
    padding: 1 2;
}

#lyrics-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

TrackActionsScreen {
    align: center middle;
}

#actions-box {
    /* Sized to its content: a four-line menu, not another full-height pane. */
    width: 46;
    max-width: 100%;
    height: auto;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#actions-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#actions-list {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: auto;
    padding: 1 1;
}

#actions-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

HelpScreen {
    align: center middle;
}

#help-box {
    /* The other modals are a fixed 84 wide, which clips at the 76x20 minimum.
       This one holds URLs, so it gives way instead of cutting them off. */
    width: 84;
    max-width: 100%;
    height: 30;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#help-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#help-body {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: 1fr;
    padding: 1 2;
}

#help-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

EqScreen {
    align: center middle;
}

#eq-box {
    width: 60;
    height: 17;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#eq-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#eq-bars {
    background: $tidalamp-display-background;
    height: 1fr;
    padding: 1 2;
}

#eq-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}
