/* Semantic palette: Omarchy when available, classic Winamp elsewhere. */

Screen {
    background: $tidalamp-screen;
    layers: base notice;
}

/* Sits above everything so a broken layout is never what the user sees. */
#too-small {
    layer: notice;
    display: none;
    width: 100%;
    height: 100%;
    background: $tidalamp-screen;
    color: $tidalamp-accent;
}

#main {
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    height: 100%;
}

#titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: center;
    text-style: bold;
    height: 1;
}

#display {
    background: $tidalamp-display-background;
    height: 9;
    padding: 0 1;
}

#clock {
    width: 24;
    height: 4;
    padding: 1 0 0 1;
}

#readout {
    width: 1fr;
    padding: 1 1 0 1;
}

#badges {
    color: $tidalamp-muted;
    height: 1;
    text-wrap: nowrap;
}

#output {
    color: $tidalamp-body;
    height: 1;
    text-wrap: nowrap;
}

/* The display band grows with the terminal to make room for a bigger cover.
   Analyzer.render already draws to whatever height it is given, so letting it
   take the slack keeps the bars beside the cover instead of leaving a hole. */
#analyzer {
    height: 1fr;
}

#seek {
    background: $tidalamp-track-background;
    padding: 0 1;
    height: 1;
}

#volume {
    background: $tidalamp-track-background;
    padding: 0 1;
    width: 100%;
    height: 1;
}

#balance {
    background: $tidalamp-track-background;
    padding: 0 1;
    width: 100%;
    height: 1;
}

#transport {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 3;
    overflow-x: hidden;
}

/* The transport keys keep their place under the sliders; everything else is
   a menu and sits against the right edge, so the two do not read as one run
   of characters. */
#transport-play {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    width: auto;
    max-width: 100%;
    height: 3;
}

#transport-menu {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    width: 1fr;
    height: 3;
    text-align: right;
    /* One line, cropped when it does not fit. Wrapped, it climbed into the
       buttons' rows and the whole band turned to soup. */
    text-wrap: nowrap;
}

#pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    /* Same gutter as #playlist below it: flush against the border, the title
       was the one row of the panel that touched the frame. */
    padding: 0 1;
    text-wrap: nowrap;
}

#playlist {
    background: $tidalamp-display-background;
    padding: 0 1;
    /* 1fr, not auto: RowList paints as many rows as it is given, so an auto
       height grows until the status bar falls off the bottom of the screen. */
    height: 1fr;
}

#status {
    background: $tidalamp-track-background;
    color: $tidalamp-body;
    height: 1;
    width: 1fr;
}

SearchScreen {
    align: center middle;
}

#search-box {
    width: 60;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    padding: 1 2;
}

#search-title {
    color: $tidalamp-accent;
    text-style: bold;
    height: 1;
}

#search-input {
    background: $tidalamp-display-background;
    color: $tidalamp-accent;
    border: tall $tidalamp-input-border;
}

BrowserScreen {
    align: center middle;
}

#browser-box {
    width: 84;
    max-width: 100%;
    height: 26;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#statusbar {
    height: 1;
    background: $tidalamp-track-background;
}

#busy {
    background: $tidalamp-track-background;
    width: auto;
    padding: 0 1;
}

#lyrics-head {
    background: $tidalamp-title-background;
    height: 1;
}

#browser-head {
    background: $tidalamp-title-background;
    height: 1;
}

#browser-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    width: 1fr;
    padding: 0 1;
}

#browser-spinner {
    background: $tidalamp-title-background;
    width: 34;
    padding: 0 1;
}

#browser-list {
    background: $tidalamp-display-background;
    height: 1fr;
    padding: 0 1;
}

#browser-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

LyricsScreen {
    align: center middle;
}

#lyrics-box {
    width: 84;
    max-width: 100%;
    height: 28;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#lyrics-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    width: 1fr;
    padding: 0 1;
}

#lyrics-spinner {
    background: $tidalamp-title-background;
    width: 34;
    padding: 0 1;
}

#lyrics-body {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: 1fr;
    padding: 1 2;
}

#lyrics-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

TrackActionsScreen {
    align: center middle;
}

#actions-box {
    /* Sized to its content: a four-line menu, not another full-height pane. */
    width: 46;
    max-width: 100%;
    height: auto;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#actions-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#actions-list {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: auto;
    padding: 1 1;
}

#actions-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

ConfigScreen {
    align: center middle;
}

#config-box {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#config-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#config-list {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: auto;
    padding: 1 1;
}

#config-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
    /* Docked, so that the line telling you how to close the window is the
       one thing a short terminal never clips off the bottom. */
    dock: bottom;
}

HelpScreen {
    align: center middle;
}

#help-box {
    /* The other modals are a fixed 84 wide, which clips at the 76x20 minimum.
       This one holds URLs, so it gives way instead of cutting them off. */
    width: 84;
    max-width: 100%;
    height: 30;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#help-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#help-body {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: 1fr;
    padding: 1 2;
}

#help-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

EqScreen {
    align: center middle;
}

#eq-box {
    width: 60;
    max-width: 100%;
    height: 17;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

/* 60–79 columns, or a short terminal: keep every action and a useful queue,
   but spend no rows or columns on decorative artwork. */
#main.compact #display {
    height: 5;
    padding: 0 1;
}

#main.compact #art {
    display: none;
}

#main.compact #clock {
    width: 20;
    height: 3;
    padding: 0;
}

#main.compact #readout {
    padding: 0 0 0 1;
}

#main.compact #analyzer {
    height: 1;
}

#main.compact #balance {
    display: none;
}

/* Three layouts share these widgets; each block below is one of them. Colour
   is the other axis and comes from the palette, so any look works with any
   palette. Adding one means adding a block here and a builder in app.py.

   Quattro: flatter hierarchy, short dividers and left-aligned headings. */
#main.quattro {
    border: solid $tidalamp-border;
}

#main.quattro #titlebar {
    background: $tidalamp-panel;
    color: $tidalamp-accent;
    text-align: left;
    padding: 0 1;
}

#main.quattro #pl-title {
    background: $tidalamp-track-background;
    color: $tidalamp-accent;
}

#main.quattro #transport {
    background: $tidalamp-panel;
}

/* Retro: the 1997 skin as far as a terminal goes. A raised outer bevel and
   title bars drawn as a rule with the heading centred on it, which is what
   told the original's two windows apart on the desktop. */
#main.retro {
    border: outer $tidalamp-border;
}

#main.retro #titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: center;
    text-style: bold;
    padding: 0;
}

#main.retro #pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: center;
    padding: 0;
}

#main.retro #transport {
    background: $tidalamp-panel;
}

/* Ascii: a terminal before it had box drawing. Textual's own `ascii` border
   draws with `+ - |`, so even the panel's edge stays typable. */
#main.ascii {
    border: ascii $tidalamp-border;
}

#main.ascii #titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: center;
    text-style: bold;
    padding: 0;
}

#main.ascii #pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: left;
    padding: 0;
}

#main.ascii #transport {
    background: $tidalamp-panel;
}

/* Nova: modern and frameless. One ground throughout, no boxes anywhere, and
   colour reserved for the two things that actually carry state. Space is the
   only separator, which is why every band here drops its own background. */
#main.nova {
    border: none;
    padding: 0 1;
}

#main.nova #titlebar {
    background: $tidalamp-panel;
    color: $tidalamp-accent;
    text-align: left;
    text-style: bold;
    padding: 0 1;
}

#main.nova #display {
    background: $tidalamp-panel;
    padding: 1 1 0 1;
}

#main.nova #seek,
#main.nova #volume,
#main.nova #balance {
    background: $tidalamp-panel;
}

#main.nova #transport {
    background: $tidalamp-panel;
}

#main.nova #pl-title {
    background: $tidalamp-panel;
    color: $tidalamp-accent;
    text-style: none;
    padding: 0 1;
}

#main.nova #playlist {
    background: $tidalamp-panel;
}

#main.nova #status,
#main.nova #statusbar {
    background: $tidalamp-panel;
}

#eq-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#eq-bars {
    background: $tidalamp-display-background;
    height: 1fr;
    padding: 1 2;
}

#eq-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}
