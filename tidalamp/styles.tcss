/* The whole interface: layout, chrome and the semantic palette behind both.
   The palette follows Omarchy when there is one and falls back to the classic
   colours otherwise; the four looks (quattro, retro, nova, ascii) are blocks
   at the foot of this file, one each. */

Screen {
    background: $tidalamp-screen;
    layers: base notice;
}

/* Every modal is centred; whether the player shows through it is the
   `transparency` setting, which the app hangs on the screen as a class.

   A type selector matches subclasses, so the `Screen` rule above was painting
   an opaque ground over the whole terminal — Textual's own `ModalScreen` dims
   to 60% and this file was overriding it without meaning to. A terminal
   cannot blur what is behind a window, so a translucent scrim is what stands
   in for it: the player stays readable around the box, dimmed enough that the
   box is plainly what has the keys. */
ModalScreen {
    align: center middle;
    background: $tidalamp-screen;
}

ModalScreen.transparent {
    background: $tidalamp-screen 55%;
}

/* With transparency on, every modal box is frosted rather than solid: the
   panel and its border let a little of what is behind them through, so the
   edge of the window reads as glass over the player instead of a hard bevel
   cut out of it. The widgets inside keep their own opaque grounds, so it is
   the frame that goes soft and never the text on a list. 85% and not less:
   at 60% the queue's own text showed through the dialogs, which reads as a
   drawing bug rather than as glass. */
.transparent #search-box,
.transparent #playlist-name-box,
.transparent #browser-box,
.transparent #lyrics-box,
.transparent #actions-box,
.transparent #picker-box,
.transparent #config-box,
.transparent #columns-box,
.transparent #help-box,
.transparent #eq-box {
    background: $tidalamp-panel 85%;
    border: outer $tidalamp-border 70%;
}

/* The two shapes a modal takes.

   A pane is a list to walk, so it takes a share of the terminal instead of a
   fixed 84x26: on a 4K screen that box was a stamp in the middle of an empty
   field, and the library it was showing four rows of has hundreds. It stops
   growing sideways at 160 columns, past which a track line is mostly gap and
   the eye has to travel to read one row. The minimum keeps it useful at the
   60x18 the app refuses to run below. */
#browser-box,
#lyrics-box,
#help-box {
    width: 85%;
    min-width: 60;
    height: 85%;
    min-height: 16;
    max-height: 100%;
}

/* The browser is a table -- title, artist, album, year, quality, duration --
   and spends every cell it is given. The other two are documents, and a
   document does not get wider than its longest line: on a 4K terminal an 85%
   box left two thirds of itself empty next to text hugging the left edge,
   which reads as a broken window rather than a roomy one. The caps are the
   widest line each one actually holds, plus air. */
#browser-box {
    max-width: 160;
}

#help-box {
    /* The licence URL and the release notes; nothing here runs past 80. */
    max-width: 96;
}

#lyrics-box {
    /* A sung line is short, and a wide measure makes it harder to follow
       down, which is the one thing this window is for. */
    max-width: 80;
}

/* Sits above everything so a broken layout is never what the user sees. */
#too-small {
    layer: notice;
    display: none;
    width: 100%;
    height: 100%;
    background: $tidalamp-screen;
    color: $tidalamp-accent;
}

#main {
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    height: 100%;
}

#titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: center;
    text-style: bold;
    height: 1;
}

#display {
    background: $tidalamp-display-background;
    height: 9;
    /* No padding on the left: the cover is the first thing in the band and a
       cell between it and the frame reads as the picture having come loose.
       Everything after it carries its own left padding, so only the artwork
       moves. The right keeps its cell, where the analyser ends. */
    padding: 0 1 0 0;
}

/* The clock and the track's identity share one column, to the right of the
   cover. `_fit_artwork` measures this column as CLOCK_WIDTH, so the box keeps
   the width the clock used to declare. */
#clockbox {
    width: 24;
    /* Two cells off the cover. At one they read as a single block and the
       digits looked stuck to the artwork. */
    padding: 0 0 0 1;
}

#clock {
    width: 100%;
    height: 4;
    padding: 1 0 0 1;
}

#trackmeta {
    color: $tidalamp-muted;
    height: 1fr;
    /* A row of air under the clock: pegged to it, the digits and the artist
       read as one block and the eye cannot tell where the time ends. */
    padding: 1 0 0 1;
    text-wrap: nowrap;
}

#readout {
    width: 1fr;
    padding: 1 1 0 1;
}

#badges {
    color: $tidalamp-muted;
    height: 1;
    text-wrap: nowrap;
}

#output {
    color: $tidalamp-body;
    height: 1;
    text-wrap: nowrap;
}

/* The display band grows with the terminal to make room for a bigger cover.
   Analyzer.render already draws to whatever height it is given, so letting it
   take the slack keeps the bars beside the cover instead of leaving a hole. */
#analyzer {
    height: 1fr;
}

#seek {
    background: $tidalamp-track-background;
    padding: 0 1;
    height: 1;
}

#volume {
    background: $tidalamp-track-background;
    padding: 0 1;
    width: 100%;
    height: 1;
}

#balance {
    background: $tidalamp-track-background;
    padding: 0 1;
    width: 100%;
    height: 1;
}

#transport {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 3;
    overflow-x: hidden;
}

/* The transport keys keep their place under the sliders; everything else is
   a menu and sits against the right edge, so the two do not read as one run
   of characters. */
#transport-play {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    width: auto;
    max-width: 100%;
    height: 3;
}

#transport-menu {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    width: 1fr;
    height: 3;
    text-align: right;
    /* One line, cropped when it does not fit. Wrapped, it climbed into the
       buttons' rows and the whole band turned to soup. */
    text-wrap: nowrap;
}

#pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    /* Same gutter as #playlist below it: flush against the border, the title
       was the one row of the panel that touched the frame. */
    padding: 0 1;
    text-wrap: nowrap;
}

#playlist {
    background: $tidalamp-display-background;
    padding: 0 1;
    /* 1fr, not auto: RowList paints as many rows as it is given, so an auto
       height grows until the status bar falls off the bottom of the screen. */
    height: 1fr;
}

#status {
    background: $tidalamp-track-background;
    color: $tidalamp-body;
    height: 1;
    width: 1fr;
}

#search-box,
#playlist-name-box {
    width: 45%;
    min-width: 50;
    max-width: 90;
    height: auto;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    padding: 1 2;
}

#search-title,
#playlist-name-title {
    color: $tidalamp-accent;
    text-style: bold;
    height: 1;
}

#search-input,
#playlist-name-input {
    background: $tidalamp-display-background;
    color: $tidalamp-accent;
    border: tall $tidalamp-input-border;
}

#browser-box {
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    padding: 1 2;
}

#statusbar {
    height: 1;
    background: $tidalamp-track-background;
}

/* The queue's search bar, between the list and the status line. Same shape as
   the browser's, because it is the same gesture on a different list. */
#queue-filter-bar {
    height: 1;
    background: $tidalamp-track-background;
}

#queue-filter {
    background: $tidalamp-track-background;
    color: $tidalamp-accent;
    border: none;
    height: 1;
    width: 1fr;
    padding: 0 1;
}

#queue-filter-count {
    background: $tidalamp-track-background;
    color: $tidalamp-transport-foreground;
    height: 1;
    width: auto;
    padding: 0 1;
}

#busy {
    background: $tidalamp-track-background;
    width: auto;
    padding: 0 1;
}

#lyrics-head {
    background: $tidalamp-title-background;
    height: 1;
}

#browser-head {
    background: $tidalamp-title-background;
    height: 1;
}

#browser-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    width: 1fr;
    padding: 0 1;
}

#browser-spinner {
    background: $tidalamp-title-background;
    width: 34;
    padding: 0 1;
}

#browser-list {
    background: $tidalamp-display-background;
    height: 1fr;
    padding: 0 1;
}

/* The filter bar, at the foot of the browser and over nothing. */
#browser-filter-bar {
    height: 1;
    background: $tidalamp-track-background;
}

#browser-filter {
    background: $tidalamp-track-background;
    color: $tidalamp-accent;
    border: none;
    height: 1;
    width: 1fr;
    padding: 0 1;
}

#browser-filter-count {
    background: $tidalamp-track-background;
    color: $tidalamp-transport-foreground;
    height: 1;
    width: auto;
    padding: 0 1;
}

#browser-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

#lyrics-box {
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    padding: 1 2;
}

#lyrics-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    width: 1fr;
    padding: 0 1;
}

#lyrics-spinner {
    background: $tidalamp-title-background;
    width: 34;
    padding: 0 1;
}

#lyrics-body {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: 1fr;
    padding: 1 2;
}

#lyrics-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

/* The playlist picker: a list to walk, so it takes a share like the browser,
   but a short one -- a playlist name is a line, not a table row. */
#picker-box {
    width: 45%;
    min-width: 46;
    max-width: 76;
    height: 60%;
    min-height: 12;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#picker-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#picker-list {
    background: $tidalamp-display-background;
    height: 1fr;
    padding: 1 1;
}

#picker-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
    dock: bottom;
}

#actions-box {
    /* Sized to its content: a four-line menu, not another full-height pane. */
    width: 35%;
    min-width: 46;
    max-width: 68;
    height: auto;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#actions-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#actions-list {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: auto;
    padding: 1 1;
}

#actions-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

#config-box {
    width: 65%;
    min-width: 60;
    /* A label, a value and a note under it. Past this the value column is
       marooned in the middle of an empty box. */
    max-width: 92;
    /* Its own text decides, with a floor. Eleven rows in the middle of a 4K
       terminal read as a business card; a share of the screen read as half an
       empty window, because a `1fr` list inside an `auto` box takes every row
       there is. The floor only rounds the card up. */
    height: auto;
    min-height: 24;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#config-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#config-list {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    /* `auto`, not `1fr`: the box is auto too, and a `1fr` child inside an
       auto parent takes every row the terminal has. */
    height: auto;
    padding: 1 2;
}

#columns-box {
    width: 40%;
    min-width: 52;
    max-width: 84;
    height: auto;
    max-height: 100%;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

#columns-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#columns-list {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: auto;
    padding: 1 1;
}

#columns-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
    dock: bottom;
}

#config-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
    /* Docked, so that the line telling you how to close the window is the
       one thing a short terminal never clips off the bottom. */
    dock: bottom;
}

#help-box {
    /* This one holds URLs, so a narrow terminal gives it the whole width
       rather than cutting them off. */
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
    padding: 1 2;
}

#help-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#help-body {
    background: $tidalamp-display-background;
    color: $tidalamp-body;
    height: 1fr;
    padding: 1 2;
}

#help-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}

#eq-box {
    width: 50%;
    min-width: 60;
    max-width: 100;
    /* Taller faders on a tall terminal: `#eq-bars` is 1fr, so the rows the
       box gains go to the bands and not to its chrome. */
    height: 40%;
    min-height: 17;
    max-height: 28;
    background: $tidalamp-panel;
    border: outer $tidalamp-border;
}

/* 60–79 columns, or a short terminal: keep every action and a useful queue,
   but spend no rows or columns on decorative artwork. */
#main.compact #display {
    height: 5;
    padding: 0 1 0 0;
}

/* Nova buys its breathing room with a row, and the compact layout has none to
   sell: at that size the queue is what the window is for. */
#main.compact.nova {
    padding: 0 1;
}

/* Nova's display band carries a row of its own padding, which its block sets
   after the compact one and therefore wins. In compact that left it a row of
   content short of the other three. */
#main.compact.nova #display {
    padding: 0 1 0 0;
}

/* Quattro's row of separation, given back where there is none to spend. */
#main.compact.quattro #titlebar {
    margin: 0;
}

#main.compact #art {
    display: none;
}

#main.compact #trackmeta {
    display: none;
}

#main.compact #clock {
    width: 20;
    height: 3;
    padding: 0;
}

#main.compact #readout {
    padding: 0 0 0 1;
}

#main.compact #analyzer {
    height: 1;
}

#main.compact #balance {
    display: none;
}

/* Three layouts share these widgets; each block below is one of them. Colour
   is the other axis and comes from the palette, so any look works with any
   palette. Adding one means adding a block here and a builder in app.py.

   Quattro: flatter hierarchy, short dividers and left-aligned headings. */
#main.quattro {
    border: solid $tidalamp-border;
}

#main.quattro #titlebar {
    background: $tidalamp-panel;
    color: $tidalamp-accent;
    /* Centred, against this look's own preference for left-aligned headings.
       Left, the wordmark lands directly over the cover and the two read as
       stacked on each other; retro reads clean at the same distance because
       its name sits in the middle and only the rule passes over the artwork.
       The heading below it stays left, so the look keeps its habit where it
       has nothing underneath to collide with. */
    text-align: center;
    padding: 0 1;
    /* A row between the bar and the band. Tried once while the wordmark was
       still left-aligned and taken back: there it gave a bar that already sat
       on top of the cover a neighbourhood of its own. Centred, the same row
       reads as separation instead of isolation. */
    margin: 0 0 1 0;
}

#main.quattro #pl-title {
    background: $tidalamp-track-background;
    color: $tidalamp-accent;
}

#main.quattro #transport {
    background: $tidalamp-panel;
}

/* Retro: the 1997 skin as far as a terminal goes. A raised outer bevel and
   title bars drawn as a rule with the heading centred on it, which is what
   told the original's two windows apart on the desktop. */
#main.retro {
    border: outer $tidalamp-border;
}

#main.retro #titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: center;
    text-style: bold;
    padding: 0;
}

#main.retro #pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: center;
    padding: 0;
}

#main.retro #transport {
    background: $tidalamp-panel;
}

/* Ascii: a terminal before it had box drawing. Textual's own `ascii` border
   draws with `+ - |`, so even the panel's edge stays typable. */
#main.ascii {
    border: ascii $tidalamp-border;
}

#main.ascii #titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: center;
    text-style: bold;
    padding: 0;
}

#main.ascii #pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-align: left;
    padding: 0;
}

#main.ascii #transport {
    background: $tidalamp-panel;
}

/* Nova: modern and frameless. One ground throughout, no boxes anywhere, and
   colour reserved for the two things that actually carry state. Space is the
   only separator, which is why every band here drops its own background. */
#main.nova {
    border: none;
    /* A row of air on top. The other three get that separation from their
       border; frameless meant the wordmark sat on row zero, against the edge
       of the terminal. Here the space is the frame, so it has to be spent. */
    padding: 1 1 0 1;
}

#main.nova #titlebar {
    background: $tidalamp-panel;
    color: $tidalamp-accent;
    text-align: left;
    text-style: bold;
    padding: 0 1;
}

#main.nova #display {
    background: $tidalamp-panel;
    padding: 1 1 0 0;
}

#main.nova #seek,
#main.nova #volume,
#main.nova #balance {
    background: $tidalamp-panel;
}

#main.nova #transport {
    background: $tidalamp-panel;
}

#main.nova #pl-title {
    background: $tidalamp-panel;
    color: $tidalamp-accent;
    text-style: none;
    padding: 0 1;
}

#main.nova #playlist {
    background: $tidalamp-panel;
}

#main.nova #status,
#main.nova #statusbar,
#main.nova #queue-filter,
#main.nova #queue-filter-count,
#main.nova #queue-filter-bar {
    background: $tidalamp-panel;
}

/* The themed looks. Each comes with a palette of its own name, but like the
   four above it only says structure here: borders, which bars carry a ground
   and where the headings sit. Colour stays the palette's, so any of these
   works under any palette the user picks afterwards. */

/* Unidad morada: a heavy armoured frame and bars on the accent, the way a
   warning display lights up. */
#main.unidad-morada {
    border: heavy $tidalamp-accent;
}

#main.unidad-morada #titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-accent;
    text-align: center;
    text-style: bold;
    padding: 0;
}

#main.unidad-morada #pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-warning;
    text-style: bold;
    padding: 0 1;
}

#main.unidad-morada #transport {
    background: $tidalamp-panel;
}

/* Pirata: rounded like a porthole, the sea running along both title bars. */
#main.pirata {
    border: round $tidalamp-container;
}

#main.pirata #titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-accent;
    text-align: center;
    text-style: bold;
    padding: 0;
}

#main.pirata #pl-title {
    background: $tidalamp-track-background;
    color: $tidalamp-accent;
    padding: 0 1;
}

#main.pirata #transport {
    background: $tidalamp-panel;
}

/* Cuaderno: a page. No frame on the sides, a margin rule down the left and
   the headings written on the ruled line, not on a bar. */
#main.cuaderno {
    border: none;
    border-left: vkey $tidalamp-danger;
    padding: 1 1 0 1;
}

/* The row of air on top, given back in compact like nova's. */
#main.compact.cuaderno {
    padding: 0 1;
}

#main.cuaderno #titlebar {
    background: $tidalamp-panel;
    color: $tidalamp-body;
    text-align: left;
    text-style: italic;
    padding: 0 1;
}

#main.cuaderno #pl-title {
    background: $tidalamp-panel;
    color: $tidalamp-danger;
    padding: 0 1;
}

#main.cuaderno #transport,
#main.cuaderno #display,
#main.cuaderno #playlist {
    background: $tidalamp-panel;
}

/* Neon noir: a thick neon frame and hard, flat bars. */
#main.neon-noir {
    border: thick $tidalamp-accent;
}

#main.neon-noir #titlebar {
    background: $tidalamp-screen;
    color: $tidalamp-container;
    text-style: bold;
    padding: 0;
}

#main.neon-noir #pl-title {
    background: $tidalamp-screen;
    color: $tidalamp-accent;
    text-style: bold;
    padding: 0 1;
}

#main.neon-noir #transport {
    background: $tidalamp-screen;
}

/* Runas: a double frame like an illuminated page, headings centred. */
#main.runas {
    border: double $tidalamp-accent;
}

#main.runas #titlebar,
#main.runas #pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-accent;
    text-align: center;
    padding: 0;
}

#main.runas #transport {
    background: $tidalamp-panel;
}

/* Reggae: a wide frame, a gold title and the queue heading in green. */
#main.reggae {
    border: wide $tidalamp-playable;
}

#main.reggae #titlebar {
    background: $tidalamp-panel;
    color: $tidalamp-accent;
    text-align: center;
    text-style: bold;
    padding: 0;
}

#main.reggae #pl-title {
    background: $tidalamp-track-background;
    color: $tidalamp-playable;
    padding: 0 1;
}

#main.reggae #transport {
    background: $tidalamp-panel;
}

/* Comodín: a dashed card edge, the title in the suit colour. */
#main.comodin {
    border: dashed $tidalamp-accent;
}

#main.comodin #titlebar {
    background: $tidalamp-title-background;
    color: $tidalamp-playable;
    text-align: center;
    text-style: bold;
    padding: 0;
}

#main.comodin #pl-title {
    background: $tidalamp-track-background;
    color: $tidalamp-accent;
    padding: 0 1;
}

#main.comodin #transport {
    background: $tidalamp-panel;
}

/* Gótico: an outer bevel like carved stone, both headings centred. */
#main.gotico {
    border: outer $tidalamp-accent;
}

#main.gotico #titlebar,
#main.gotico #pl-title {
    background: $tidalamp-title-background;
    color: $tidalamp-accent;
    text-align: center;
    text-style: bold;
    padding: 0;
}

#main.gotico #transport {
    background: $tidalamp-panel;
}

/* Death metal: a tall block frame, bone on black and the red kept for the
   headings. */
#main.death-metal {
    border: tall $tidalamp-accent;
}

#main.death-metal #titlebar {
    background: $tidalamp-screen;
    color: $tidalamp-accent;
    text-align: center;
    text-style: bold;
    padding: 0;
}

#main.death-metal #pl-title {
    background: $tidalamp-screen;
    color: $tidalamp-body;
    text-style: bold;
    padding: 0 1;
}

#main.death-metal #transport {
    background: $tidalamp-screen;
}

#eq-title {
    background: $tidalamp-title-background;
    color: $tidalamp-title-foreground;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

#eq-bars {
    background: $tidalamp-display-background;
    height: 1fr;
    padding: 1 2;
}

#eq-hint {
    background: $tidalamp-transport-background;
    color: $tidalamp-transport-foreground;
    height: 1;
}
